# ============================================================
# 复制为 .env 后按需修改；docker compose 会自动读取同目录 .env
#   cp .env.example .env
# 或者直接跑一键部署，脚本会自动生成带随机密钥的 .env：
#   bash deploy.sh
#
# 全部留空也能跑：端口默认 8080，密钥留空 = 不鉴权（仅内网/本机测试）
# ============================================================

# 对外访问端口（Nginx 映射）。留空或不写 = 8080；
# 8080 被别的程序占用时，deploy.sh 会自动顺延到下一个可用端口并写回这里
INDRA_PORT=8080

# 公开部署务必设置一个强随机 Key；留空 = 不鉴权（仅内网/本机测试用）
INDRA_API_KEY=

# 模型来源：1 = 只用本地 models/（内网必须）；0 = 允许首次联网下载（约 72MB）
# 不写 = 1（离线）
HF_HUB_OFFLINE=1

# ---------------- Worker 形态 ----------------
# 每个 worker 的 onnxruntime 线程数。默认 1 = 一个 worker 吃 1 个核。
# 吞吐靠"多开 worker"，不靠单 worker 多线程（多线程只加快单个文档）。
OCR_THREADS=1
# 单副本资源上限（1 线程时 1.5 核足够；内存 1g 是保守值）
WORKER_CPUS=1.5
WORKER_MEM=1g

# 可选覆盖（不填则用 docker-compose.yml 里的默认值）
# MAX_QUEUE=1000      # 队列上限，超出 POST /v1/jobs 返回 429（背压）
# JOB_TTL=86400       # 任务完成后结果保留秒数

# ---------------- 自动伸缩（scripts/autoscale.sh 读取本文件）----------------
MIN_WORKERS=1       # 缩容下限：最少保留几个 worker
MAX_WORKERS=8       # 扩容上限：最多加到几个（超过 CPU 核数会被自动夹到核数）
# INTERVAL=5        # 采样间隔秒
# IDLE_SECS=90      # 队列连续空闲多久才缩容
# SCALE_COOLDOWN=15 # 两次调整之间的最小间隔（给新 worker 加载模型的时间）
